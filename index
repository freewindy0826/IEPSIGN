<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>개별화교육계획 전자서명</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Noto Sans KR', sans-serif; }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 antialiased">

    <!-- 토스트 알림 -->
    <div id="toast" class="fixed top-5 right-5 z-50 transform translate-x-full opacity-0 transition-all duration-300 ease-in-out bg-slate-900 text-white px-5 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3 text-sm pointer-events-none">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toastMessage">처리가 완료되었습니다.</span>
    </div>

    <!-- 교사 관리자 화면 -->
    <div id="teacherApp" class="max-w-5xl mx-auto px-4 py-8">
        <!-- 상단 헤더 -->
        <header class="bg-white rounded-2xl p-6 mb-6 shadow-sm border border-slate-200/80 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-100">
                    <i class="fa-solid fa-file-signature text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">개별화교육계획 전자서명 수합</h1>
                        <span class="bg-indigo-50 text-indigo-700 text-xs font-semibold px-2.5 py-0.5 rounded-full border border-indigo-200">배포용</span>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">별도의 서버 가입 없이 학부모 스마트폰으로 즉시 서명 및 PDF를 수합합니다.</p>
                </div>
            </div>
            <button onclick="openNewModal()" class="bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-medium px-5 py-3 rounded-xl shadow-md shadow-indigo-100 transition-all text-sm flex items-center justify-center space-x-2">
                <i class="fa-solid fa-plus text-xs"></i>
                <span>새 서명 요청 만들기</span>
            </button>
        </header>

        <!-- 학생 목록 테이블 -->
        <main class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h2 class="font-bold text-slate-800 text-lg">학생별 서명 요청 목록</h2>
                    <p class="text-xs text-slate-500">QR코드 또는 링크를 학부모님께 전달하여 서명을 요청하세요.</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-500 border-b border-slate-100 text-xs font-semibold uppercase">
                        <tr>
                            <th class="px-6 py-3.5">학생명</th>
                            <th class="px-6 py-3.5">문서명</th>
                            <th class="px-6 py-3.5">요청 일시</th>
                            <th class="px-6 py-3.5">서명 상태</th>
                            <th class="px-6 py-3.5 text-right">서명 공유 / 관리</th>
                        </tr>
                    </thead>
                    <tbody id="requestTableBody" class="divide-y divide-slate-100 text-slate-700">
                    </tbody>
                </table>
            </div>
            
            <div id="emptyState" class="p-12 text-center">
                <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-folder-open text-2xl"></i>
                </div>
                <p class="text-slate-600 font-medium">등록된 서명 요청이 없습니다.</p>
                <p class="text-xs text-slate-400 mt-1">[+ 새 서명 요청 만들기] 버튼을 눌러 학생을 등록해주세요.</p>
            </div>
        </main>
    </div>

    <!-- 학부모 모바일 서명 화면 -->
    <div id="parentApp" class="hidden min-h-screen bg-slate-100 py-6 px-4">
        <div class="max-w-md mx-auto bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden">
            <!-- 안내 헤더 -->
            <div class="bg-indigo-600 p-6 text-white text-center">
                <span class="inline-block bg-indigo-500/60 text-indigo-100 text-xs px-3 py-1 rounded-full mb-2">개별화교육계획 서명 요청</span>
                <h2 id="parentStudentHeader" class="text-xl font-bold">학생 개별화교육계획</h2>
                <p class="text-xs text-indigo-100 mt-1.5">아래 내용을 확인하신 후 정자로 서명해 주세요.</p>
            </div>

            <!-- 서명 작성 폼 -->
            <div id="parentFormBox" class="p-5 space-y-5">
                <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-4 flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-file-contract text-lg"></i>
                    </div>
                    <div class="truncate">
                        <p id="parentDocTitle" class="text-sm font-bold text-slate-800 truncate">개별화교육계획 협의 확인서</p>
                        <p class="text-xs text-slate-500">특수교육대상자 개별화교육지원팀</p>
                    </div>
                </div>

                <div class="bg-slate-50 rounded-xl p-4 border border-slate-200/80 text-xs text-slate-600 leading-relaxed space-y-2">
                    <p class="font-bold text-slate-800">📌 학부모 동의 및 확인 안내</p>
                    <p>본인은 해당 학생의 개별화교육계획 수립 및 운영 내용에 대해 협의하였으며 이에 동의합니다.</p>
                    <label class="flex items-center space-x-2 pt-2 border-t border-slate-200 cursor-pointer font-bold text-indigo-900">
                        <input type="checkbox" id="agreeCheck" class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500">
                        <span>내용을 확인하였으며 이에 동의합니다.</span>
                    </label>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-xs font-bold text-slate-700">학부모 서명란 <span class="text-red-500">*</span></label>
                        <button onclick="clearSignatureCanvas()" class="text-xs text-slate-400 hover:text-red-500 flex items-center space-x-1">
                            <i class="fa-solid fa-rotate-left text-[10px]"></i>
                            <span>지우기</span>
                        </button>
                    </div>
                    
                    <div class="relative bg-white border-2 border-dashed border-slate-300 rounded-xl overflow-hidden touch-none">
                        <canvas id="signatureCanvas" class="w-full h-44 cursor-crosshair block bg-white"></canvas>
                        <div id="canvasPlaceholder" class="absolute inset-0 pointer-events-none flex items-center justify-center text-slate-300 text-xs">
                            여기에 정자로 서명해 주세요
                        </div>
                    </div>
                </div>

                <button onclick="submitParentSignature()" class="w-full py-4 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold rounded-xl shadow-lg shadow-indigo-100 transition-all text-sm flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-check text-base"></i>
                    <span>서명 완료 및 확인서 발급</span>
                </button>
            </div>

            <!-- 서명 완료 화면 -->
            <div id="parentSuccessBox" class="hidden p-6 text-center space-y-4">
                <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-sm">
                    <i class="fa-solid fa-circle-check text-3xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-slate-800">서명이 정상 완료되었습니다!</h3>
                    <p class="text-xs text-slate-500 mt-1">서명 확인서가 생성되었습니다. 아래 버튼으로 보관하거나 선생님께 전송하세요.</p>
                </div>

                <!-- PDF 다운로드 영역 (숨김 렌더링용) -->
                <div class="p-2">
                    <button onclick="downloadPdfDirect()" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-file-arrow-down text-base"></i>
                        <span>서명 확인서 PDF 다운로드</span>
                    </button>
                </div>

                <div class="pt-1">
                    <button onclick="notifyTeacherViaMsg()" class="w-full py-3.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-paper-plane text-indigo-300"></i>
                        <span>선생님께 완료 알림 문자/카톡 보내기</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- PDF 인쇄용 숨김 템플릿 -->
    <div id="pdfTemplate" class="hidden max-w-lg mx-auto bg-white p-8 border border-slate-300 rounded-lg text-slate-800 space-y-6">
        <div class="text-center border-b-2 border-slate-800 pb-4">
            <h1 class="text-xl font-bold">개별화교육계획 학부모 서명 확인서</h1>
            <p class="text-xs text-slate-500 mt-1">본 확인서는 특수교육 개별화교육계획 협의 및 서명 증빙용 문서입니다.</p>
        </div>
        <div class="space-y-2 text-xs">
            <div class="flex justify-between border-b pb-1">
                <span class="text-slate-500 font-semibold">학생 성명:</span>
                <span id="pdfStudentName" class="font-bold text-slate-900">-</span>
            </div>
            <div class="flex justify-between border-b pb-1">
                <span class="text-slate-500 font-semibold">문서명:</span>
                <span id="pdfDocName" class="font-bold text-slate-900">개별화교육계획서</span>
            </div>
            <div class="flex justify-between border-b pb-1">
                <span class="text-slate-500 font-semibold">서명 일시:</span>
                <span id="pdfSignDate" class="font-bold text-slate-900">-</span>
            </div>
            <div class="flex justify-between border-b pb-1">
                <span class="text-slate-500 font-semibold">확인 내용:</span>
                <span class="font-bold text-emerald-600">내용 확인 및 동의 완료</span>
            </div>
        </div>
        <div class="border rounded-lg p-4 text-center bg-slate-50">
            <p class="text-xs text-slate-500 mb-2 font-semibold">학부모 서명</p>
            <img id="pdfSignImg" class="h-24 mx-auto object-contain bg-white border p-1 rounded">
        </div>
    </div>

    <!-- 신규 생성 모달 -->
    <div id="newModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl p-6 border border-slate-100">
            <h3 class="font-bold text-slate-800 text-lg mb-4">새 서명 요청 생성</h3>
            <form onsubmit="handleCreateRequest(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">학생 이름 <span class="text-red-500">*</span></label>
                    <input type="text" id="inputStudentName" required placeholder="예: 홍길동" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">문서명 / 학기</label>
                    <input type="text" id="inputDocName" value="1학기 개별화교육계획" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div class="pt-3 flex space-x-3">
                    <button type="button" onclick="closeNewModal()" class="w-1/2 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-medium text-sm">취소</button>
                    <button type="submit" class="w-1/2 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm">생성하기</button>
                </div>
            </form>
        </div>
    </div>

    <!-- QR 코드 모달 -->
    <div id="qrModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center shadow-2xl relative">
            <button onclick="closeQrModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <h3 id="qrStudentTitle" class="font-bold text-slate-800 text-lg mb-1">학부모 서명 QR코드</h3>
            <p class="text-xs text-slate-500 mb-4">스마트폰 카메라로 스캔하면 바로 서명창이 열립니다.</p>
            <div id="qrcodeCanvas" class="p-4 bg-slate-50 rounded-2xl inline-block border border-slate-100 mb-4"></div>
            <button onclick="copyCurrentShareLink()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-medium">
                서명 URL 링크 복사
            </button>
        </div>
    </div>

    <script>
        let currentRequests = [];
        let activeStudent = null;
        let isDrawing = false;
        let hasSignature = false;
        let activeCtx = null;
        let lastSignedDataUrl = '';

        function getStorage() {
            try {
                return JSON.parse(localStorage.getItem('iep_no_backend_requests')) || [];
            } catch(e) { return []; }
        }

        function setStorage(data) {
            localStorage.setItem('iep_no_backend_requests', JSON.stringify(data));
        }

        function formatDate() {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
        }

        function renderList() {
            currentRequests = getStorage();
            const tbody = document.getElementById('requestTableBody');
            const empty = document.getElementById('emptyState');
            tbody.innerHTML = '';

            if (currentRequests.length === 0) {
                empty.classList.remove('hidden');
                return;
            }
            empty.classList.add('hidden');

            currentRequests.forEach(req => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 border-b border-slate-100";
                tr.innerHTML = `
                    <td class="px-6 py-4 font-bold text-slate-800">${req.name}</td>
                    <td class="px-6 py-4 text-slate-600 text-xs">${req.docName}</td>
                    <td class="px-6 py-4 text-xs text-slate-400">${req.date}</td>
                    <td class="px-6 py-4">
                        <button onclick="toggleStatus('${req.id}')" class="px-2.5 py-1 rounded-full text-xs font-semibold ${req.signed ? 'bg-emerald-50 text-emerald-600 border border-emerald-200' : 'bg-amber-50 text-amber-600 border border-amber-200'}">
                            ${req.signed ? '✓ 서명 완료' : '⌛ 서명 대기'}
                        </button>
                    </td>
                    <td class="px-6 py-4 text-right space-x-1 whitespace-nowrap">
                        <button onclick="openQrModal('${req.id}')" class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-indigo-600 text-xs font-medium hover:bg-indigo-50">
                            <i class="fa-solid fa-qrcode mr-1"></i>QR/링크
                        </button>
                        <button onclick="deleteReq('${req.id}')" class="px-2 py-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 text-xs">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function handleCreateRequest(e) {
            e.preventDefault();
            const name = document.getElementById('inputStudentName').value.trim();
            const docName = document.getElementById('inputDocName').value.trim() || '개별화교육계획서';
            const list = getStorage();
            list.unshift({
                id: 'std_' + Date.now(),
                name: name,
                docName: docName,
                date: formatDate(),
                signed: false
            });
            setStorage(list);
            closeNewModal();
            renderList();
            showToast(`${name} 학생 서명 요청이 생성되었습니다.`);
        }

        function toggleStatus(id) {
            const list = getStorage();
            const item = list.find(r => r.id === id);
            if (item) {
                item.signed = !item.signed;
                setStorage(list);
                renderList();
            }
        }

        function deleteReq(id) {
            let list = getStorage().filter(r => r.id !== id);
            setStorage(list);
            renderList();
            showToast("삭제되었습니다.");
        }

        function openNewModal() {
            document.getElementById('inputStudentName').value = '';
            document.getElementById('newModal').classList.remove('hidden');
        }
        function closeNewModal() {
            document.getElementById('newModal').classList.add('hidden');
        }

        function getShareUrl(req) {
            const base = window.location.href.split('?')[0];
            return `${base}?sn=${encodeURIComponent(req.name)}&doc=${encodeURIComponent(req.docName)}`;
        }

        function openQrModal(id) {
            const req = getStorage().find(r => r.id === id);
            if (!req) return;
            activeStudent = req;
            document.getElementById('qrStudentTitle').innerText = `${req.name} 학생 서명 QR코드`;
            const container = document.getElementById('qrcodeCanvas');
            container.innerHTML = '';
            new QRCode(container, {
                text: getShareUrl(req),
                width: 180,
                height: 180,
                colorDark: "#1e1b4b",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
            document.getElementById('qrModal').classList.remove('hidden');
        }

        function copyCurrentShareLink() {
            if (!activeStudent) return;
            const url = getShareUrl(activeStudent);
            navigator.clipboard.writeText(url).then(() => {
                showToast("학부모 전송용 링크가 복사되었습니다!");
            });
        }

        function closeQrModal() {
            document.getElementById('qrModal').classList.add('hidden');
        }

        // 학부모 캔버스 서명 드로잉 로직
        function initCanvas() {
            const canvas = document.getElementById('signatureCanvas');
            if (!canvas) return;
            activeCtx = canvas.getContext('2d');
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width || 320;
            canvas.height = 176;

            function startDraw(e) {
                isDrawing = true;
                hasSignature = true;
                document.getElementById('canvasPlaceholder').style.display = 'none';
                activeCtx.beginPath();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                const r = canvas.getBoundingClientRect();
                activeCtx.moveTo(clientX - r.left, clientY - r.top);
                activeCtx.strokeStyle = '#000';
                activeCtx.lineWidth = 3;
                activeCtx.lineCap = 'round';
            }

            function draw(e) {
                if (!isDrawing) return;
                e.preventDefault();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                const r = canvas.getBoundingClientRect();
                activeCtx.lineTo(clientX - r.left, clientY - r.top);
                activeCtx.stroke();
            }

            function stopDraw() { isDrawing = false; }

            canvas.addEventListener('mousedown', startDraw);
            canvas.addEventListener('mousemove', draw);
            canvas.addEventListener('mouseup', stopDraw);
            canvas.addEventListener('touchstart', startDraw, { passive: false });
            canvas.addEventListener('touchmove', draw, { passive: false });
            canvas.addEventListener('touchend', stopDraw);
        }

        function clearSignatureCanvas() {
            const canvas = document.getElementById('signatureCanvas');
            if (!canvas || !activeCtx) return;
            activeCtx.clearRect(0, 0, canvas.width, canvas.height);
            hasSignature = false;
            document.getElementById('canvasPlaceholder').style.display = 'flex';
        }

        function submitParentSignature() {
            if (!document.getElementById('agreeCheck').checked) {
                showToast("동의 체크박스를 확인해 주세요.", "error");
                return;
            }
            if (!hasSignature) {
                showToast("서명을 작성해 주세요.", "error");
                return;
            }

            const canvas = document.getElementById('signatureCanvas');
            lastSignedDataUrl = canvas.toDataURL('image/png');

            document.getElementById('parentFormBox').classList.add('hidden');
            document.getElementById('parentSuccessBox').classList.remove('hidden');

            // 즉시 PDF 다운로드 실행
            downloadPdfDirect();
        }

        function downloadPdfDirect() {
            const urlParams = new URLSearchParams(window.location.search);
            const studentName = urlParams.get('sn') || '학생';
            const docName = urlParams.get('doc') || '개별화교육계획';
            const now = formatDate();

            document.getElementById('pdfStudentName').innerText = studentName;
            document.getElementById('pdfDocName').innerText = docName;
            document.getElementById('pdfSignDate').innerText = now;
            document.getElementById('pdfSignImg').src = lastSignedDataUrl;

            const element = document.getElementById('pdfTemplate');
            element.classList.remove('hidden');

            const opt = {
                margin: 10,
                filename: `[서명확인서]_${studentName}_개별화교육계획.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                element.classList.add('hidden');
                showToast("서명 확인서 PDF 저장이 시작되었습니다.");
            });
        }

        function notifyTeacherViaMsg() {
            const urlParams = new URLSearchParams(window.location.search);
            const studentName = urlParams.get('sn') || '학생';
            const text = `[개별화교육계획 서명 완료]\n${studentName} 학생 학부모 전자서명 및 확인서 발급을 완료하였습니다.`;

            if (navigator.share) {
                navigator.share({ title: '서명 완료 알림', text: text }).catch(() => {});
            } else {
                window.location.href = `sms:?body=${encodeURIComponent(text)}`;
            }
        }

        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('translate-x-full', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-x-full', 'opacity-0'), 3000);
        }

        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            const studentName = urlParams.get('sn');

            if (studentName) {
                // 학부모 모드 접속
                document.getElementById('teacherApp').classList.add('hidden');
                document.getElementById('parentApp').classList.remove('hidden');
                document.getElementById('parentStudentHeader').innerText = `${studentName} 학생 개별화교육계획`;
                document.getElementById('parentDocTitle').innerText = urlParams.get('doc') || '개별화교육계획 협의 확인서';
                setTimeout(initCanvas, 100);
            } else {
                // 교사 모드 접속
                renderList();
            }
        };
    </script>
</body>
</html>
